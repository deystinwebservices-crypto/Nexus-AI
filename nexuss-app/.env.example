# ============================================================================
# NEXUSS AI — SERVER-SIDE ENVIRONMENT VARIABLES (NETLIFY FUNCTIONS)
# Copy this file to .env for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY RULE:
# Never prefix secret keys with VITE_ (anything with VITE_ is bundled into the
# public browser code). Keep GEMINI_API_KEY strictly server-side.
# ============================================================================

GEMINI_API_KEY="paste-your-google-ai-studio-key-inside-dotenv-never-here"
GEMINI_MODEL="gemini-2.5-flash"